# Keep line endings right on both platforms, whatever core.autocrlf is set to.
# A shell script with CRLF fails on Linux and in WSL with a baffling error, and
# a .cmd file wants CRLF, so neither is left to chance.
* text=auto

*.sh   text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.pdf  binary
*.ico  binary
*.mp3  binary
